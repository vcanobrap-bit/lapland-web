# --- Base de datos -----------------------------------------------------------
# Local: la base de `npm run db` (clave fija, solo para tu máquina)
# Producción: connection string de Neon / Supabase (en Supabase: Transaction pooler + ?uselibpqcompat=true&sslmode=require)
DATABASE_URI=postgres://lapland:lapland@127.0.0.1:5432/lapland_web

# --- Payload -----------------------------------------------------------------
# Clave para firmar tokens y cookies. Generar con: openssl rand -base64 32
PAYLOAD_SECRET=

# --- URLs --------------------------------------------------------------------
# Sin barra final. En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Preview de borradores ---------------------------------------------------
# Clave para autorizar el draft mode. Generar con: openssl rand -base64 32
PREVIEW_SECRET=

# --- Almacenamiento de medios (solo producción) ------------------------------
# Token de Vercel Blob. En local se usa el filesystem y puede quedar vacío.
BLOB_READ_WRITE_TOKEN=
